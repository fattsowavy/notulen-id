# Salin file ini menjadi .env, lalu isi nilainya. Jangan commit file .env.

# Token Hugging Face (izin read) untuk model pyannote.
HF_TOKEN=

# API key untuk backend LLM yang kompatibel dengan OpenAI. Kosongkan jika memakai Ollama.
LLM_API_KEY=

# Alamat server Ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# Menyembunyikan peringatan symlink cache Hugging Face di Windows.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
